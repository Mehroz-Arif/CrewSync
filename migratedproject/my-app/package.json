{
  "name": "my-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.1",
      "zod": "^4.3.6",
      "@types/bun": "^1.3.11",
      "better-auth": "^1.5.6",
      "@prisma/client": "^7.6.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --if-present --filter '*' check-types",
    "dev:native": "bun run --filter native dev",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @my-app/db db:push",
    "db:studio": "bun run --filter @my-app/db db:studio",
    "db:generate": "bun run --filter @my-app/db db:generate",
    "db:migrate": "bun run --filter @my-app/db db:migrate"
  },
  "dependencies": {
    "@my-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.6"
}
