{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@my-app/auth": "workspace:*",
    "@my-app/db": "workspace:*",
    "@my-app/env": "workspace:*",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  }
}
